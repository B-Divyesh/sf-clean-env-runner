# Static hosting policy. Keep HTML and the service worker revalidatable so an updated
# shell takes effect promptly; Vite content hashes make every /assets/ response safe
# to cache for a year. This file is copied unchanged to dist/site/_headers.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/environment-proof.webp
  Cache-Control: public, max-age=31536000, immutable

/environment-proof-mobile.webp
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache, must-revalidate

/*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(self)
